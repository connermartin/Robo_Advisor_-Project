# Copy this file to .env and paste your free API keys.
# The app still runs without them (it falls back to sample data / default assumptions).

# https://finnhub.io/register  (free tier: real-time US quotes, ~60 calls/min)
FINNHUB_API_KEY=

# https://fred.stlouisfed.org/docs/api/api_key.html  (free)
FRED_API_KEY=
